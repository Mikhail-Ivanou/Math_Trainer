rules_version = '2';

// Math Trainer data model
//
//   books/{bookId}                          textbook                         — backend only (Admin SDK)
//   books/{bookId}/sections/{sectionId}     one § with its rule sheet        — backend only
//   books/{b}/sections/{s}/rules/{ruleId}   one rule of that §               — backend only
//   catalog/grade-{n}                       all rules of a grade             — backend only
//   topics/{ruleId}                         a rule a student added to work on — created by the app
//   topics/{ruleId}/requests/{uid}          why that student added it        — owner only
//   topics/{ruleId}/tasks/{taskId}          exercises, shared by all         — backend, or created by the app
//   users/{uid}                             profile                          — owner only
//   users/{uid}/progress/{progressId}       "solved" marks                   — owner only
//
// The backend writes through the Admin SDK, which bypasses these rules, so
// everything not opened below is closed for clients.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function optionalString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    function ruleDoc(data, ruleId) {
      return /databases/$(database)/documents/books/$(data.bookId)/sections/$(data.sectionId)/rules/$(ruleId);
    }

    // A topic is a textbook rule someone added: its id is the rule id and its
    // fields are copied from that rule verbatim, so a topic can't be invented
    // or edited on the way.
    function validTopic(data, topicId) {
      let copied = ['bookId', 'bookTitle', 'sectionId', 'grade', 'subject', 'chapter', 'chapterTitle',
                    'sectionNumber', 'sectionTitle', 'title', 'rule'];
      let all = copied.concat(['createdBy', 'createdAt']);
      return data.keys().hasOnly(all) && data.keys().hasAll(all)
          && data.bookId is string && data.sectionId is string
          && exists(ruleDoc(data, topicId))
          && get(ruleDoc(data, topicId)).data.diff(data).unchangedKeys().hasAll(copied)
          && data.createdBy == request.auth.uid
          && data.createdAt == request.time;
    }

    // A task generated on a phone: written once by its author, never changed.
    // The app has already checked the answer (task_verifier.dart); the rules
    // make sure the document has the right shape and author.
    function validAppTask(data, topicId) {
      return data.keys().hasAll(['type', 'difficulty', 'question', 'answer', 'source', 'createdBy', 'createdAt', 'model'])
          && data.keys().hasOnly(['type', 'difficulty', 'question', 'answer', 'source', 'createdBy', 'createdAt', 'model',
                                  'expr', 'equation', 'variable', 'solution_expr', 'unit'])
          && data.type in ['expression', 'equation', 'word', 'simplify']
          && data.difficulty in ['easy', 'medium', 'hard']
          && data.question is string && data.question.size() >= 3 && data.question.size() <= 1000
          && data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 100
          && data.source == 'app'
          && data.createdBy == request.auth.uid
          && data.createdAt == request.time
          && data.model is string && data.model.size() <= 100
          && optionalString(data, 'expr', 300)
          && optionalString(data, 'equation', 300)
          && optionalString(data, 'variable', 10)
          && optionalString(data, 'solution_expr', 300)
          && optionalString(data, 'unit', 50)
          && exists(/databases/$(database)/documents/topics/$(topicId));
    }

    match /books/{bookId} {
      allow read: if signedIn();

      match /sections/{sectionId} {
        allow read: if signedIn();

        match /rules/{ruleId} {
          allow read: if signedIn();
        }
      }
    }

    match /catalog/{gradeId} {
      allow read: if signedIn();
    }

    match /topics/{topicId} {
      allow read: if signedIn();
      allow create: if signedIn() && validTopic(request.resource.data, topicId);

      match /requests/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        // The topic may be created in the same batch, hence existsAfter.
        allow create, update: if signedIn() && request.auth.uid == uid
            && existsAfter(/databases/$(database)/documents/topics/$(topicId))
            && request.resource.data.keys().hasOnly(['text', 'createdAt'])
            && request.resource.data.text is string && request.resource.data.text.size() <= 500
            && request.resource.data.createdAt == request.time;
      }

      match /tasks/{taskId} {
        allow read: if signedIn();
        allow create: if signedIn() && validAppTask(request.resource.data, topicId);
      }
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /progress/{progressId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['topicId', 'taskId', 'solved', 'updatedAt'])
            && request.resource.data.topicId is string
            && request.resource.data.taskId is string
            && request.resource.data.solved is bool
            && request.resource.data.updatedAt == request.time;
      }
    }
  }
}
